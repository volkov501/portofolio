# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.mp4
# short project clips shown by the video player (keep each file small, see public/projects/videos/README.md)
!public/projects/videos/*.mp4

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# confidential procurement documents (RAB / server specs) — keep out of the public repo
*.docx
*.xlsx

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
